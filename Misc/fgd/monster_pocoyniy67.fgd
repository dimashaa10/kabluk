//
// monster_pocoyniy67.fgd -- описание NPC для TrenchBroom
//
// Файл для редактора карт, а не для игры. Игра (QuakeC + движок) этот файл
// не читает вообще; он нужен только TrenchBroom, чтобы в списке entity был
// "monster_pocoyniy67" с картинкой модели, правильным размером и подсказками
// к полям.
//
// КАК ПОДКЛЮЧИТЬ
//
//   Вариант 1 (рекомендуется, если у вас уже есть свой quake.fgd):
//     открыть свой .fgd и вставить в конец блок "@PointClass ..." ниже
//     (всё, что между строками "НАЧАЛО БЛОКА" и "КОНЕЦ БЛОКА").
//     Классов с базовыми (base) мы не объявляем, поэтому конфликтов имён с
//     вашим файлом не будет.
//
//   Вариант 2: указать этот файл как единственный.
//     В TrenchBroom: Preferences -> Game Configurations -> Quake ->
//     "Entity Definitions" -> выбрать этот .fgd.
//     Минус: стандартные entity Quake при этом пропадут из списка, если
//     они не описаны в этом же файле.
//
// ЧТО ЗДЕСЬ ОБЕЩАНО И ПОЧЕМУ ТОЛЬКО ЭТО
//
// В FGD имеет смысл писать только те ключи, которые игра действительно
// читает. У этого NPC в QC нет ни одной строки, которая смотрит в ключи
// карты, поэтому полей ровно два:
//
//   angle       -- направление, в котором NPC стоит при появлении.
//                  Движок сам превращает одиночный ключ "angle" в
//                  angles = '0 angle 0' (Quake/pr_edict.c, "anglehack"),
//                  а QC берёт angles_y в ideal_yaw при спавне. То есть
//                  значение работает, хотя QC ключ и не читает.
//
//   spawnflags  -- четыре бита, которые обрабатывает САМ движок для любой
//                  entity при загрузке карты (Quake/pr_edict.c,
//                  ED_LoadFromFile): "не спавнить на такой сложности" и
//                  "не спавнить в deathmatch". QC их тоже не трогает --
//                  и не должен.
//
// Чего здесь СОЗНАТЕЛЬНО нет:
//
//   health      -- здоровье в QC жёстко 50 (self.health = POC_HEALTH), ключ
//                  карты был бы перезаписан при спавне. Поле, которое
//                  молча ничего не делает, хуже, чем его отсутствие.
//   targetname  -- NPC ни на что не реагирует и сам ничего не триггерит,
//                  поэтому имя ему нечего давать. Понадобится, когда
//                  добавите реакцию на триггер -- тогда и добавите строку.
//   model       -- модель задаётся в QC (precache_model + setmodel), менять
//                  её ключом карты нельзя.
//
// ============================ НАЧАЛО БЛОКА ============================

@PointClass size(-16 -16 -24, 16 16 32) color(96 200 120)
    model({ "path": "progs/pocoyniy67.mdl" })
    = monster_pocoyniy67 : "Pocoyniy 67 -- мирный NPC, 50 hp, не атакует"
[
    angle(integer) : "Направление взгляда при появлении: 0 = восток, 90 = север, 180 = запад, 270 = юг." : 0 : "Движок превращает этот ключ в angles = (0, angle, 0), а QC берёт angles_y в ideal_yaw. К этой стороне NPC поворачивается, когда начинает идти."

    spawnflags(flags) : "Spawnflags" =
    [
        256 : "Не спавнить на Easy" : 0
        512 : "Не спавнить на Normal" : 0
        1024 : "Не спавнить на Hard" : 0
        2048 : "Не спавнить в Deathmatch" : 0
    ]
]

// ============================= КОНЕЦ БЛОКА =============================
//
// Размер в size() тот же, что setsize (self, '-16 -16 -24', '16 16 32') в
// Misc/qc/monster_pocoyniy67.qc: рамка в редакторе совпадает с тем, чем
// монстр реально упирается в стены.
//
// Модель одна, анимации внутри неё:
//     кадры  1..20 -- idle
//     кадры 21..30 -- передвижение
//     кадры 31..47 -- смерть
// В редакторе показывается кадр 0 модели -- то есть первый кадр idle.
// Если хочется видеть в редакторе другой кадр, TrenchBroom понимает
//     model({ "path": "progs/pocoyniy67.mdl", "frame": 20 })
// но это влияет только на редактор, игра кадр из FGD не читает.
